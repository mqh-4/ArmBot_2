<launch>
  <arg name="image_topic" default="/astra/color/image_raw"/>
  <arg name="camera_info_topic" default="/astra/color/camera_info"/>
  <arg name="mode" default="collect"/>
  <arg name="result" default="/home/ubuntu/share/tmp/ArmBot/output/eye_to_hand_result.json"/>
  <arg name="base_frame" default="base_link"/>
  <!-- link5 is the rigid wrist/flange reference after the gripper is removed. -->
  <arg name="end_frame" default="link5"/>
  <arg name="samples" default="/home/ubuntu/share/tmp/ArmBot/output/eye_to_hand_samples.json"/>
  <arg name="target_samples" default="15"/>
  <arg name="allow_motion" default="false"/>
  <arg name="step_pulse" default="15"/>
  <arg name="motion_duration" default="1.0"/>

  <node pkg="desk_cleaning" type="eye_to_hand_calibration.py"
        name="eye_to_hand_calibration_collector" output="screen"
        args="--mode $(arg mode) --result $(arg result)">
    <env name="DISPLAY" value="$(optenv DISPLAY :0)"/>
    <env name="QT_X11_NO_MITSHM" value="1"/>
    <param name="image_topic" value="$(arg image_topic)"/>
    <param name="camera_info_topic" value="$(arg camera_info_topic)"/>
    <param name="base_frame" value="$(arg base_frame)"/>
    <param name="end_frame" value="$(arg end_frame)"/>
    <param name="samples" value="$(arg samples)"/>
    <param name="target_samples" value="$(arg target_samples)"/>
    <param name="allow_motion" value="$(arg allow_motion)"/>
    <param name="step_pulse" value="$(arg step_pulse)"/>
    <param name="motion_duration" value="$(arg motion_duration)"/>
  </node>
</launch>
